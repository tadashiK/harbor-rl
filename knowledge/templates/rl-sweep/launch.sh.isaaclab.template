#!/bin/bash -l
#
#SBATCH --array=0-{{N_MINUS_1}}
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --time={{TIME_LIMIT}}
#SBATCH --gres=gpu:{{GPU_TYPE}}:1
#SBATCH --job-name={{SWEEP_ID}}
#SBATCH --output=%x_%A_%a.out
# stdout/stderr -> {{SWEEP_ID}}_<jobid>_<arrayidx>.out in $SLURM_SUBMIT_DIR.

# Auto-generated by /harbor:rl-sweep cluster=... -- DO NOT HAND-EDIT.
# Sweep id : {{SWEEP_ID}}
# Trials   : {{N_TRIALS}} (Cartesian product of {{PARSED_ARGS_SUMMARY}})
# Repo     : {{REPO_PATH}}
# Generated: {{GENERATED_AT}}
#
# Rendered by /harbor:rl-sweep cluster=... and by reward-tune's cluster mode.
# IsaacLab-flavored launch: bare-metal isaacsim wheels require glibc 2.34+,
# which most HPC sites (RHEL/AlmaLinux 8) don't provide, so the trial command
# runs inside an apptainer image (built once from python:3.11-slim) that has
# torch + isaacsim + IsaacLab editable pre-installed plus an NVIDIA Vulkan
# ICD manifest (apptainer --nv injects libGLX_nvidia.so.0 but NOT the ICD
# JSON). Build recipe: <repo>/harbor/apptainer/isaaclab.def.

set -e

# Repo root is baked in at render time (the absolute path of the repo the sweep
# was generated from). Override with HARBOR_REPO_ROOT when submitting from a
# host where the repo lives elsewhere.
# (sbatch copies the script to a spool dir, so $0-relative path resolution is
# unreliable on SLURM -- an absolute path is required.)
REPO_ROOT="${HARBOR_REPO_ROOT:-{{REPO_PATH}}}"
SIF="$REPO_ROOT/harbor/apptainer/isaaclab.sif"

# Mount point inside the container. Must match the path the .sif's editable
# install expects; the renderer derives it from the repo directory name.
CONTAINER_ROOT="/repo/{{REPO_NAME}}"

if [ ! -d "$REPO_ROOT" ]; then
    echo "[ERROR] repo root not found: $REPO_ROOT" >&2
    echo "        Re-submit with HARBOR_REPO_ROOT=/path/to/repo" >&2
    exit 1
fi

if [ ! -f "$SIF" ]; then
    echo "[ERROR] $SIF missing -- build it once with:" >&2
    echo "  cd $REPO_ROOT/harbor/apptainer && apptainer build --fakeroot --force isaaclab.sif isaaclab.def" >&2
    exit 1
fi

# WANDB credentials live in $HOME/.netrc on the host; apptainer auto-mounts
# $HOME so they're available inside the container. Override only if the env
# var is set in the SLURM environment.
export WANDB_API_KEY=${WANDB_API_KEY:-{{WANDB_API_KEY}}}

# Most HPC sites firewall outbound HTTPS from compute nodes; Kit needs S3
# access to fetch USD assets and wandb needs the API. Set your site's proxy
# with the `proxy=` arg to /harbor:rl-sweep, or export HTTP(S)_PROXY in the
# SLURM environment. Empty default = no proxy. Add your site's internal
# domains to NO_PROXY so intra-cluster traffic bypasses the proxy.
export HTTP_PROXY=${HTTP_PROXY-{{PROXY_DEFAULT}}}
export HTTPS_PROXY=${HTTPS_PROXY-{{PROXY_DEFAULT}}}
export NO_PROXY=${NO_PROXY:-localhost,127.0.0.1}

# --- Trial table (parallel arrays; index = $SLURM_ARRAY_TASK_ID) ---
TRIAL_IDS=(
{{TRIAL_IDS}}
)
TRIAL_CMDS=(
{{TRIAL_COMMANDS}}
)

ID="${TRIAL_IDS[$SLURM_ARRAY_TASK_ID]}"
CMD="${TRIAL_CMDS[$SLURM_ARRAY_TASK_ID]}"
echo "[sweep {{SWEEP_ID}}] trial $SLURM_ARRAY_TASK_ID :: $ID"
echo "[host] $(hostname); GPU(s):"
nvidia-smi -L 2>&1 | head -5
echo "[cmd] apptainer exec --nv --writable-tmpfs --bind $REPO_ROOT:$CONTAINER_ROOT --pwd $CONTAINER_ROOT $SIF $CMD"

# --writable-tmpfs gives Kit a RAM-backed overlay so its writes to
# /opt/venv/.../isaacsim/kit/{cache,data} succeed (the .sif is read-only).
# OMNI_KIT_ACCEPT_EULA + PRIVACYACCEPT skip interactive prompts on first-run.
apptainer exec \
    --nv \
    --writable-tmpfs \
    --bind "$REPO_ROOT:$CONTAINER_ROOT" \
    --pwd "$CONTAINER_ROOT" \
    --env OMNI_KIT_ACCEPT_EULA=YES \
    --env PRIVACYACCEPT=YES \
    --env WANDB_API_KEY="$WANDB_API_KEY" \
    --env HTTP_PROXY="$HTTP_PROXY" \
    --env HTTPS_PROXY="$HTTPS_PROXY" \
    --env http_proxy="$HTTP_PROXY" \
    --env https_proxy="$HTTPS_PROXY" \
    --env NO_PROXY="$NO_PROXY" \
    --env no_proxy="$NO_PROXY" \
    "$SIF" \
    bash -c "$CMD"
