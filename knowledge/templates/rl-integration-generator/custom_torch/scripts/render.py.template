"""
{{PROJECT_NAME}} — render a trained policy to video.mp4 (custom_torch).

Single env (n=1), offscreen rendering enabled, runs ONE episode with the loaded
checkpoint and writes:

    <checkpoint-dir>/render.mp4
    <checkpoint-dir>/render_contact_sheet.jpg

Always produces a visible artifact — works on headless hosts because it uses
offscreen rendering. To open a live window, use the env's native viewer.

Example:
    python harbor/scripts/rl/custom_torch/render.py algo=ppo task={{DEFAULT_TASK}} \\
        checkpoint=harbor/outputs/<trial_id>/checkpoint.pth
"""
from __future__ import annotations

import sys
from pathlib import Path

# IsaacGym/bidexhands quirk: pre-import any `<repo>/scripts/_*_env.py` helper
# BEFORE `import torch`, since some sims (IsaacGym) refuse to load if torch is
# already imported. No-op for repos without such a helper.
_REPO_FOR_PREIMPORT = Path(__file__).resolve().parents[4]
sys.path.insert(0, str(_REPO_FOR_PREIMPORT / "scripts"))
for _hp in (_REPO_FOR_PREIMPORT / "scripts").glob("_*_env.py"):
    try:
        __import__(_hp.stem)  # noqa: F401
        break
    except ImportError:
        continue

import hydra
import numpy as np
import torch
from omegaconf import DictConfig, OmegaConf

REPO     = Path(__file__).resolve().parents[4]   # actual repo root
HARBOR = Path(__file__).resolve().parents[3]   # <repo>/harbor
sys.path.insert(0, str(HARBOR))
sys.path.insert(0, str(REPO))

CUSTOM_ROOT = Path(__file__).resolve().parents[0]
sys.path.insert(0, str(CUSTOM_ROOT))

from algo import alg_name_to_path  # noqa: E402
from utils.common import load_class_from_path  # noqa: E402
from env_wrapper import create_render_env  # noqa: E402


def _resolve_algo_class(name: str):
    target = "Agent" + name.upper() if not name.startswith("Agent") else name
    if target in alg_name_to_path:
        return load_class_from_path(target, alg_name_to_path[target])
    for cls_name, path in alg_name_to_path.items():
        if cls_name.lower() == target.lower():
            return load_class_from_path(cls_name, path)
    raise KeyError(f"Algorithm '{name}' not found in registry.")


def _grab_frame(env) -> np.ndarray | None:
    raw = getattr(env, "_raw_env", None)
    target = raw if raw is not None else env
    try:
        frame = target.render()
    except Exception:
        return None
    # torch tensor from GPU-batched sims (ManiSkill returns (N, H, W, 3) uint8)
    if isinstance(frame, torch.Tensor):
        frame = frame.detach().cpu().numpy()
    if isinstance(frame, np.ndarray):
        if frame.ndim == 4 and frame.shape[0] == 1:
            frame = frame[0]
        return frame.astype(np.uint8)
    if isinstance(frame, list) and frame and isinstance(frame[0], np.ndarray):
        return frame[0].astype(np.uint8)
    return None


# ---------------------------------------------------------------------------
# Follow-cam (benchmark-agnostic).
#
# For MOVING tasks (e.g. locomotion) the tracked body translates away from a
# fixed camera and walks out of frame. The follow-cam tracks it so it stays
# framed. It is NOT IsaacLab-specific: it probes the APIs of each benchmark
# family for the two primitives it needs — read the tracked body's world
# position, and move the viewer/render camera — and simply NO-OPS (keeps the
# default/static camera) on any sim that exposes neither. Fixed-base tasks
# (e.g. manipulation) never trigger it because the body never moves past the
# engage radius, so their renders are unchanged. Disable with camera_follow=false.
# Add a new family by extending _track_body_pos_w() / _set_viewer_camera().
# ---------------------------------------------------------------------------

def _cam_unwrapped(env):
    raw = getattr(env, "_raw_env", env)
    return getattr(raw, "unwrapped", raw)


def _env_origin_w(env) -> np.ndarray:
    """World-frame origin of env 0 (for the initial framing). Zeros if unknown."""
    u = _cam_unwrapped(env)
    try:
        return u.scene.env_origins[0].detach().cpu().numpy().astype(float)
    except Exception:
        return np.zeros(3, dtype=float)


def _track_body_pos_w(env):
    """Best-effort world position (x, y, z) of the body to follow (env 0), across sims.

    Returns np.ndarray shape (3,), or None if no known API applies (→ follow-cam
    won't engage and the default camera is kept). Extend with more families as needed.
    """
    u = _cam_unwrapped(env)
    # IsaacLab / IsaacGym managed envs: an Articulation named "robot" with root_pos_w.
    try:
        pos = u.scene["robot"].data.root_pos_w[0]
        return pos.detach().cpu().numpy().astype(float)
    except Exception:
        pass
    # ManiSkill / SAPIEN: the controlled agent's root pose.
    try:
        p = u.agent.robot.pose.p
        p = p.detach().cpu().numpy() if hasattr(p, "detach") else np.asarray(p)
        return np.asarray(p, dtype=float).reshape(-1)[:3]
    except Exception:
        pass
    return None


# --- ManiSkill follow-cam rig ------------------------------------------------------------
# WHY THIS EXISTS. Under `sim_backend=physx_cuda` ManiSkill renders human cameras through a
# sapien RenderCameraGroup whose pose is `gpu_pose[cam.gpu_pose_batch_index] * cam.local_pose`.
# `local_pose` is read ONCE, at group-creation time, and MSScene._sapien_update_render builds
# that group exactly once behind the `_human_render_cameras_initialized` latch. So
# `RenderCamera.set_local_pose()` is accepted, reads back correctly, and never changes a pixel
# — which silently no-opped the follow-cam for EVERY GPU-sim ManiSkill task. Harmless for a
# fixed-base tabletop task; fatal for locomotion, where the robot simply walks out of frame.
#
# Two fixes were measured before this one was chosen:
#   - Forcing a re-bake (clearing the latch before each update_render) DOES rebuild the group,
#     but on the default UNMOUNTED camera the frame comes back byte-identical (its pose is read
#     from an absent gpu row, not the CPU one) AND it leaks ~10 MB of GPU memory per frame.
#     Rejected: no pixels moved and it leaks.
#   - Binding the camera to the gpu pose row of a body we control makes the pose live: it is
#     re-read every frame, costs ~1.8 ms/frame and leaks nothing. That is what this does.
#
# The rig is a 1 mm kinematic, collision-free box, so it cannot perturb physics or observations,
# and it sits exactly at the camera origin — inside the 0.01 m near plane — so it is never drawn.
_MS_RIG_PATCHED: set = set()


def _maniskill_install_cam_rig(cfg) -> bool:
    """Add a `cam_rig` body to the task's env class. MUST run BEFORE the env is built.

    Runtime patch only — the benchmark's source is never edited. No-ops (returning False) for
    non-ManiSkill families and for any ManiSkill version whose API does not match.
    """
    try:
        import sapien  # noqa: F401  — present only in a SAPIEN/ManiSkill env
        from mani_skill.utils.building import actors
        from mani_skill.utils.registration import REGISTERED_ENVS

        spec = REGISTERED_ENVS.get(str(cfg.get("task")))
        if spec is None:
            return False
        env_cls = spec.cls
        if env_cls in _MS_RIG_PATCHED:
            return True
        orig = env_cls._load_scene

        def _load_scene(self, options: dict):
            orig(self, options)
            try:
                self.cam_rig = actors.build_box(
                    self.scene,
                    half_sizes=(0.0005, 0.0005, 0.0005),
                    color=(0.0, 0.0, 0.0, 1.0),
                    name="cam_rig",
                    body_type="kinematic",
                    add_collision=False,
                    initial_pose=sapien.Pose(p=[0.0, 0.0, -5.0]),
                )
            except Exception:
                self.cam_rig = None

        env_cls._load_scene = _load_scene
        _MS_RIG_PATCHED.add(env_cls)
        return True
    except Exception:
        return False


def _maniskill_bind_cam_rig(env) -> bool:
    """Point the human render camera at the rig's gpu pose row and rebuild the group ONCE.

    Call AFTER the first render (the render system group does not exist before it).
    """
    u = _cam_unwrapped(env)
    if getattr(u, "_harbor_cam_rig_bound", False):
        return True
    rig = getattr(u, "cam_rig", None)
    if rig is None:
        return False
    try:
        import sapien
        import sapien.physx as physx

        # The render system group and the camera group are created lazily, on the FIRST render.
        # Bind before that and there is nothing to rebind, so force one frame here rather than
        # depending on call order in main().
        try:
            u.render()
        except Exception:
            pass

        scene = u.scene
        cams = getattr(scene, "human_render_cameras", None)
        if not isinstance(cams, dict) or not cams:
            return False
        name, sensor = next(iter(cams.items()))
        idx = (
            rig._objs[0]
            .find_component_by_type(physx.PhysxRigidBodyComponent)
            .gpu_pose_index
        )
        for comp in sensor.camera._render_cameras:
            comp.set_gpu_pose_batch_index(idx)
            comp.set_local_pose(sapien.Pose())  # camera pose == rig pose
        textures = list(sensor.config.shader_config.texture_names.keys())
        group = scene.render_system_group.create_camera_group(
            sensor.camera._render_cameras, textures
        )
        sensor.camera.camera_group = group
        scene.camera_groups[name] = group
        u._harbor_cam_rig_bound = True
        return True
    except Exception:
        return False


def _sync_render_markers(env) -> None:
    """Let a task re-stage debug-marker poses immediately before a frame is grabbed.

    ManiSkill's `Actor.set_pose` only STAGES a row of `px.cuda_rigid_body_data`; the step's next
    `gpu_fetch_rigid_dynamic_data` overwrites it with the marker's un-applied sim pose, so a
    marker written during `_step` renders frozen. A task that draws markers can define
    `_sync_render_markers(self)` and this template will call it after the last fetch of the step.
    Simulation is unaffected — the marker is kinematic and collision-free.
    """
    u = _cam_unwrapped(env)
    fn = getattr(u, "_sync_render_markers", None)
    if callable(fn):
        try:
            fn()
        except Exception:
            pass


def _set_viewer_camera(env, eye, target) -> bool:
    """Best-effort: point the render/viewer camera from ``eye`` at ``target`` (world m).

    Returns True if a known camera API accepted it; unknown sims keep their default
    camera (follow-cam no-ops there).
    """
    u = _cam_unwrapped(env)
    eye = [float(v) for v in eye]
    target = [float(v) for v in target]
    # IsaacLab: the sim exposes a viewer camera setter.
    try:
        u.sim.set_camera_view(eye=eye, target=target)
        return True
    except Exception:
        pass
    # ManiSkill / SAPIEN. Two paths, and the order matters — see _maniskill_install_cam_rig.
    #
    # 1. If the camera rig is bound, write the RIG's pose. Under sim_backend=physx_cuda this is
    #    the ONLY thing that actually moves the camera: the render camera group renders from
    #    `gpu_pose[cam.gpu_pose_batch_index] * cam.local_pose`, and only the gpu_pose half is
    #    re-read per frame.
    # 2. Otherwise fall back to set_local_pose, which DOES work on the CPU backend.
    try:
        from mani_skill.utils.sapien_utils import look_at
        from mani_skill.utils.structs.pose import Pose as MSPose

        rig = getattr(u, "cam_rig", None)
        if rig is not None and getattr(u, "_harbor_cam_rig_bound", False):
            raw = look_at(eye, target, up=(0, 0, 1)).raw_pose
            raw = np.asarray(raw.detach().cpu().numpy() if hasattr(raw, "detach") else raw).reshape(-1)
            import sapien

            rig.set_pose(MSPose.create(sapien.Pose(p=raw[:3], q=raw[3:])))
            return True

        pose = look_at(eye, target)
        cams = getattr(u.scene, "human_render_cameras", None)
        cam = next(iter(cams.values())) if isinstance(cams, dict) and cams else None
        setter = None
        if cam is not None:
            setter = getattr(cam, "set_pose", None) or getattr(getattr(cam, "camera", None), "set_local_pose", None)
        if setter is not None:
            setter(pose)
            # HONEST RETURN. On physx_cuda this call is accepted and reads back correctly but
            # does not change a single pixel, so reporting True here is what made the follow-cam
            # silently no-op for every GPU-sim ManiSkill task. Only claim success when the rig
            # is bound or we are on a backend where the CPU-side pose is what renders.
            gpu = bool(getattr(getattr(u, "scene", None), "gpu_sim_enabled", False))
            return not gpu
    except Exception:
        pass
    return False


def _write_mp4(frames: list[np.ndarray], path: Path, fps: int = 30) -> None:
    if not frames:
        print("[render] no frames captured — skipping mp4 write", file=sys.stderr); return
    try:
        import imageio.v2 as imageio
    except ImportError:
        import imageio  # type: ignore[no-redef]
    imageio.mimsave(str(path), frames, fps=fps, codec="libx264", quality=8)


def _write_contact_sheet(frames: list[np.ndarray], path: Path) -> None:
    if not frames:
        return
    try:
        from PIL import Image
    except ImportError:
        return
    n = len(frames)
    indices = sorted({0, n // 4, n // 2, 3 * n // 4, n - 1})
    sample = [Image.fromarray(frames[i]) for i in indices]
    h = max(im.height for im in sample)
    w = sum(im.width for im in sample)
    sheet = Image.new("RGB", (w, h))
    x = 0
    for im in sample:
        sheet.paste(im, (x, 0))
        x += im.width
    sheet.save(str(path), quality=85)


@hydra.main(version_base=None, config_path="../../../configs/rl", config_name="ppo")
def main(cfg: DictConfig):
    OmegaConf.set_struct(cfg, False)

    if "algo" not in cfg or not isinstance(cfg.get("algo"), DictConfig):
        algo_name = str(cfg.get("algo", "ppo"))
        cfg.algo = OmegaConf.create({
            "name": algo_name,
            "act_class": cfg.get("act_class") or _default_act_class(algo_name),
            "cri_class": cfg.get("cri_class") or _default_cri_class(algo_name),
            "actor_lr": 3.0e-4, "critic_lr": 3.0e-4,
            "tracker_len": 100, "obs_norm": False,
            "alpha": cfg.get("alpha", None), "alpha_lr": 3.0e-4,
            "no_tgt_actor": True, "nstep": 1,
        })
    cfg.device = str(cfg.get("device", "cuda" if torch.cuda.is_available() else "cpu"))
    cfg.num_envs = 1
    # Honor cfg.gpu_sim — GPU-batched simulators (IsaacLab / IsaacGym / ManiSkill GPU)
    # cannot be replaced with a CPU gymnasium.make for render. create_render_env knows
    # how to launch with cameras enabled when gpu_sim=True.

    task = cfg.get("task")
    ckpt_path = cfg.get("checkpoint")
    # Read the keys the unified config declares (render_fps / render_max_steps);
    # fall back to the legacy fps / max_steps names. Reading declared keys means a
    # plain `render_max_steps=150` override works without Hydra's `+` append prefix.
    fps = int(cfg.get("render_fps", cfg.get("fps", 30)))
    max_steps = int(cfg.get("render_max_steps", cfg.get("max_steps", 1000)))
    if task is None:
        print("[error] task=<id> is required.", file=sys.stderr); sys.exit(2)
    if not ckpt_path:
        print("[error] checkpoint=<path> is required.", file=sys.stderr); sys.exit(2)
    ckpt = Path(ckpt_path)
    if not ckpt.is_absolute():
        ckpt = REPO / ckpt
    if not ckpt.exists():
        print(f"[error] checkpoint not found: {ckpt}", file=sys.stderr); sys.exit(2)

    # ManiSkill only, and a no-op elsewhere: the camera rig body must exist before the scene is
    # built, so this patches the env class ahead of create_render_env(). See the rig helpers.
    _maniskill_install_cam_rig(cfg)

    env = create_render_env(cfg)
    # Tighten max_steps to the env's episode horizon when available — avoids
    # rendering 1000 steps on a 300-step env.
    raw_env = getattr(env, "_raw_env", env)
    env_max_len = getattr(getattr(raw_env, "unwrapped", raw_env), "max_episode_length", None)
    if env_max_len is not None and int(env_max_len) > 0:
        max_steps = min(max_steps, int(env_max_len) + 1)
        print(f"[render] capping max_steps at env.max_episode_length+1 = {max_steps}", flush=True)
    # Pre-load checkpoint to detect whether obs/value normalization was used
    # during training. If yes, force-enable on cfg.algo BEFORE building the
    # agent so the agent allocates obs_rms / value_rms ready to be populated.
    # Without this, the actor (trained on normalized obs) sees raw OOD obs at
    # inference and produces garbage — symptom is render returns far below
    # the training-time episodic_return_mean.
    state = torch.load(str(ckpt), map_location=cfg.device, weights_only=False)
    if state.get("obs_norm") or "obs_rms" in state:
        OmegaConf.update(cfg, "algo.obs_norm", True, merge=True)
    if state.get("value_norm") or "value_rms" in state:
        OmegaConf.update(cfg, "algo.value_norm", True, merge=True)
    agent_cls = _resolve_algo_class(str(cfg.algo.name))
    agent = agent_cls(env=env, cfg=cfg)
    agent.actor.load_state_dict(state["actor"])
    agent.critic.load_state_dict(state["critic"])
    if "obs_rms" in state and getattr(agent, "obs_rms", None) is not None:
        agent.obs_rms.load_state_dict(state["obs_rms"])
        print("[render] restored obs_rms from checkpoint", flush=True)
    if "value_rms" in state and getattr(agent, "value_rms", None) is not None:
        agent.value_rms.load_state_dict(state["value_rms"])
        print("[render] restored value_rms from checkpoint", flush=True)
    agent.actor.eval()

    frames: list[np.ndarray] = []
    obs, _ = env.reset()

    # Position the viewer camera for a wide isometric view of the robot + workspace.
    # Default eye=(1.35, 1.00, 0.75) m diagonal from the workspace, looking down at
    # target=(0.35, 0, 0.10) just above the table surface. Override per-task via cfg.viewer_eye / cfg.viewer_target.
    #
    # For MOVING tasks (locomotion) also arm a follow-cam: once the tracked body drifts past
    # a small radius, track it every frame keeping this initial framing offset, so it stays
    # in view. Benchmark-agnostic (see _track_body_pos_w / _set_viewer_camera); fixed-base
    # tasks never trigger it → their renders are unchanged. Disable with camera_follow=false.
    camera_follow = bool(cfg.get("camera_follow", True))
    follow_cam: dict = {}
    # Shared render resolution. Angle alone is not enough for by-eye comparison: three
    # benchmarks of the same task at 512x512 / 640x480 / 1280x720 read as three different
    # things. The family's env_wrapper must honour this when it builds the render camera.
    render_resolution = tuple(cfg.get("render_resolution", (1280, 720)))
    try:
        viewer_eye    = np.asarray(cfg.get("viewer_eye",    [1.35, 1.00, 0.75]), dtype=float)
        viewer_target = np.asarray(cfg.get("viewer_target", [0.35, 0.0, 0.10]), dtype=float)
        env_origin = _env_origin_w(env)
        eye    = viewer_eye + env_origin
        target = viewer_target + env_origin
        # ManiSkill only: bind the render camera to the rig's gpu pose row. Must come AFTER the
        # first render (the render system group does not exist before it) and BEFORE the first
        # _set_viewer_camera, so that call takes the rig path rather than the no-op path.
        if _maniskill_bind_cam_rig(env):
            print("[render] ManiSkill follow-cam rig bound (camera pose is live per frame)", flush=True)
        if _set_viewer_camera(env, eye, target):
            print(f"[render] viewer camera   eye={eye.tolist()}  target={target.tolist()}", flush=True)
        if camera_follow:
            start = _track_body_pos_w(env)
            if start is not None:
                # maintain the initial camera pose RELATIVE to the tracked body.
                follow_cam = {
                    "eye_off": eye - start, "target_off": target - start,
                    "start_xy": start[:2].copy(), "active": False, "trigger": 0.3,
                }
    except Exception as _camera_err:
        print(f"[render] could not set viewer camera ({_camera_err}) — using default", flush=True)

    ep_return = 0.0
    act_abs_sum = 0.0
    act_abs_min = float("inf")
    act_abs_max = 0.0
    act_count = 0
    for step in range(max_steps):
        # Follow-cam: once the tracked body moves past the trigger radius, track it so a
        # moving robot stays framed. No-op for fixed-base tasks (never trigger).
        if follow_cam:
            try:
                root = _track_body_pos_w(env)
                if root is not None:
                    if not follow_cam["active"] and \
                            np.linalg.norm(root[:2] - follow_cam["start_xy"]) > follow_cam["trigger"]:
                        follow_cam["active"] = True
                        print(f"[render] follow-cam engaged at step {step}", flush=True)
                    if follow_cam["active"]:
                        _set_viewer_camera(env, root + follow_cam["eye_off"], root + follow_cam["target_off"])
            except Exception:
                pass
        _sync_render_markers(env)
        f = _grab_frame(env)
        if f is not None:
            frames.append(f)
        with torch.no_grad():
            # Normalize obs via obs_rms BEFORE calling the actor — training's
            # rollout path (agent.get_actions in ppo.py) normalizes first, so
            # the actor was trained on normalized inputs. Skipping this step
            # silently produces near-zero performance even with the correct
            # checkpoint loaded.
            obs_in = agent.obs_rms.normalize(obs) if getattr(agent, "obs_rms", None) is not None else obs
            if hasattr(agent.actor, "get_actions"):
                # Stochastic eval — sample from the action distribution rather than
                # take the deterministic mean. For under-trained PPO policies the
                # mean is near-zero (entropy hasn't collapsed yet) and the robot
                # stays stationary, producing 301 visually-identical frames.
                action = agent.actor.get_actions(obs_in, sample=True)
                if isinstance(action, tuple):
                    action = action[0]
            else:
                action = agent.actor(obs_in)
        # Track |action| stats so the summary line proves inference actually ran
        # (a strictly-zero mean means the checkpoint state-dict didn't load and
        # inference fell through to a default-init policy). rl-render Check #1
        # parses `action|abs|.mean` from the `[render] wrote ...` line.
        if isinstance(action, torch.Tensor):
            _aabs = action.abs()
            _m = float(_aabs.mean().item())
            act_abs_sum += _m
            act_abs_min = min(act_abs_min, float(_aabs.min().item()))
            act_abs_max = max(act_abs_max, float(_aabs.max().item()))
            act_count += 1
            if step < 3:
                print(f"[render] step={step}  action|abs|.mean={_m:.4f}", flush=True)
        next_obs, reward, done, info = env.step(action)
        if isinstance(reward, torch.Tensor):
            ep_return += float(reward.mean().item())   # mean across envs (works for n=1 too)
        else:
            ep_return += float(reward)
        # Multi-env render: if num_envs > 1 the env auto-resets terminated envs
        # internally — we should NOT break on first done, just keep rendering for
        # max_steps. Single-env (.numel() == 1) IS the episode terminator.
        if isinstance(done, torch.Tensor) and done.numel() > 1:
            obs = next_obs; continue
        if bool(done.item() if isinstance(done, torch.Tensor) else done):
            _sync_render_markers(env)
            f = _grab_frame(env)
            if f is not None:
                frames.append(f)
            break
        obs = next_obs

    out_dir = ckpt.parent
    mp4 = out_dir / "render.mp4"
    sheet = out_dir / "render_contact_sheet.jpg"
    _write_mp4(frames, mp4, fps=fps)
    _write_contact_sheet(frames, sheet)
    _act_mean = (act_abs_sum / act_count) if act_count else 0.0
    _act_min = act_abs_min if act_count else 0.0
    print(f"[render] wrote {mp4} ({len(frames)} frames, return={ep_return:.4f}, "
          f"action|abs|.mean={_act_mean:.4f} max={act_abs_max:.4f} min={_act_min:.4f})", flush=True)

    # Hard-exit BEFORE Kit / sim shutdown. With some IsaacLab + Isaac Sim
    # combos (e.g. 5.1) `sim_app.close()` hangs on USD stage detach — render
    # hangs indefinitely AFTER the MP4 is on disk. The MP4 + contact sheet
    # are flushed above, so we skip the cleanup. Avoids an external watchdog.
    import os as _os
    _os.sync()
    _os._exit(0)


def _default_act_class(algo: str) -> str:
    a = algo.lower()
    if a == "ppo": return "DiagGaussianMLPPolicy"
    if a == "sac": return "TanhDiagGaussianMLPPolicy"
    return "TanhMLPPolicy"


def _default_cri_class(algo: str) -> str:
    return "MLPCritic" if algo.lower() == "ppo" else "DoubleQ"


if __name__ == "__main__":
    main()
