"""
{{PROJECT_NAME}} — random-action rollout that writes an MP4 (render sanity check).

Purpose
-------
Builds the benchmark env, runs N random-action steps, captures one RGB frame
per step, and writes them to an MP4. Proves that the offscreen render
pipeline is wired (camera obs / env.render() / GL+EGL stack) WITHOUT
requiring a trained policy or X11.

Used as the L2 smoke tier by benchmark-generator. For headed visualization,
launch the script directly under your host display (the env's GUI window
will appear in parallel with the offscreen rendering).

Example
-------
    python scripts/render_random.py --task {{TASK_EXAMPLE}} --n-steps 30 \\
        --output /tmp/{{PROJECT_NAME}}_random.mp4
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

import numpy as np


def parse_args():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[1] if __doc__ else "")
    p.add_argument("--task", default="{{TASK_EXAMPLE}}",
                   help="Task identifier (default: %(default)s)")
    p.add_argument("--n-steps", type=int, default=30,
                   help="Frames to capture (default: %(default)s)")
    p.add_argument("--output", required=True,
                   help="Output MP4 path (e.g. /tmp/random.mp4)")
    p.add_argument("--fps", type=int, default=30,
                   help="MP4 frame rate (default: %(default)s)")
    p.add_argument("--seed", type=int, default=0)
    return p.parse_args()


def build_env(task: str):
    """Build the benchmark env. PLACEHOLDER — substituted at generation time.

    Unlike run_random.py, this entry point may need rendering enabled
    (e.g. `render_mode='rgb_array'` for gymnasium, `has_offscreen_renderer=True`
    for robosuite). benchmark-generator picks the smallest config that
    yields RGB frames via {{SMOKE_ENV_BUILD_RENDER}}.
    """
    {{SMOKE_ENV_BUILD_RENDER}}
    return env


def sample_action(env):
    return {{SMOKE_ACTION_EXPR}}


def extract_frame(env, obs, info):
    """Return one RGB (H, W, 3) uint8 ndarray, or None if unavailable.

    PLACEHOLDER — benchmark-generator substitutes {{VIDEO_FRAME_EXTRACT}}
    with the benchmark-specific expression. Examples:
      - gymnasium: env.render() if env.render_mode == 'rgb_array' else None
      - SAPIEN:    env.render_cameras()[0]['rgb']
      - robosuite: obs.get('robot0_agentview_left_image')
      - dm_control + shimmy: env.render()
    """
    return {{VIDEO_FRAME_EXTRACT}}


def main():
    args = parse_args()
    out_path = Path(args.output)
    out_path.parent.mkdir(parents=True, exist_ok=True)

    env = build_env(args.task)
    try:
        obs, info = env.reset(seed=args.seed)
    except TypeError:
        obs = env.reset()
        info = {}
    except ValueError:
        # Older gym API returns just obs.
        obs = env.reset()
        info = {}

    frames: list[np.ndarray] = []
    for i in range(args.n_steps):
        out = env.step(sample_action(env))
        if isinstance(out, tuple) and len(out) == 5:
            obs, _r, _term, _trunc, info = out
        elif isinstance(out, tuple) and len(out) == 4:
            obs, _r, _done, info = out
        else:
            obs, info = out, {}
        frame = extract_frame(env, obs, info)
        if frame is not None:
            frames.append(np.asarray(frame, dtype=np.uint8))

    if not frames:
        print("FAIL: no RGB frames captured (check {{VIDEO_FRAME_EXTRACT}} expression)",
              file=sys.stderr)
        sys.exit(2)

    try:
        import imageio.v2 as imageio
    except ImportError:
        import imageio  # type: ignore[no-redef]

    imageio.mimsave(str(out_path), frames, fps=args.fps, codec="libx264", quality=8)
    size_kb = out_path.stat().st_size / 1024
    print(f"L2 OK: wrote {len(frames)} frames to {out_path} ({size_kb:.1f} KB)")


if __name__ == "__main__":
    main()
