"""Cfg for EMACumulativeDeltaPoseAction.

Rendered alongside `ema_delta_ee_pose.py`. Drop into the new task's
`mdp/actions_cfg.py` (alongside or instead of the joint-pos cfg).
Inherits `DifferentialInverseKinematicsActionCfg`, so all fields from that
class (`asset_name`, `joint_names`, `body_name`, `body_offset`, `controller`,
...) work the same. The `controller` field MUST have
`use_relative_mode=False` — the EMA term forces absolute IK internally and
will raise otherwise.

Extras beyond the parent:
    scale               6-element scale (3 pos + 3 axis-angle rot). Override the
                        parent's float scale with a 6-D list.
    alpha               EMA weight in [0, 1]. 1.0 = no smoothing.
    pos_lower_limit     Optional 3-element list[float]. Per-axis position
    pos_upper_limit     clamp on the post-EMA pose target. Both must be set
                        together; otherwise no clamp.
"""
from dataclasses import MISSING

from isaaclab.envs.mdp.actions import DifferentialInverseKinematicsActionCfg
from isaaclab.managers.action_manager import ActionTerm
from isaaclab.utils import configclass

from .actions import EMACumulativeDeltaPoseAction


@configclass
class EMACumulativeDeltaPoseActionCfg(DifferentialInverseKinematicsActionCfg):
    class_type: type[ActionTerm] = EMACumulativeDeltaPoseAction

    scale: tuple[float, ...] = (0.02, 0.02, 0.02, 0.02, 0.02, 0.02)
    """Per-channel scale: (sx, sy, sz, srx, sry, srz). Default 0.02 m / 0.02 rad
    per unit policy output (plugin convention — EE-pose deltas are typically
    much smaller than joint deltas, since 1 cm/step is already a substantial
    Cartesian move). For joint-pos analog, use scale=0.2."""

    alpha: float = 0.5
    """EMA weight in [0, 1]. Default 0.5 (plugin convention — half-and-half blend
    against the previously-applied target). 1.0 disables smoothing."""

    pos_lower_limit: list[float] | None = None
    pos_upper_limit: list[float] | None = None
    """Optional per-axis (xyz) clamp on the post-EMA position target."""
