"""
{{PROJECT_NAME}} — RL evaluation entry point (stable-baselines3).

Loads a checkpoint, runs `n_episodes` deterministic rollouts on a vec env, prints
mean return + episode length to stdout AND writes metrics.json next to the checkpoint.

Always headless. Always uses the same vec-env factory as train.py (so the action/obs
shapes match what the policy was trained on).

Example:
    python harbor/scripts/rl/stable_baseline3/eval.py algo=ppo task={{DEFAULT_TASK}} \\
        checkpoint=harbor/outputs/<trial_id>/checkpoint.zip \\
        n_episodes=10
"""
from __future__ import annotations

import json
import sys
import time
from pathlib import Path

import hydra
import numpy as np
from omegaconf import DictConfig, OmegaConf

from stable_baselines3 import PPO, SAC, TD3, DDPG, A2C

REPO     = Path(__file__).resolve().parents[4]   # actual repo root
HARBOR = Path(__file__).resolve().parents[3]   # <repo>/harbor
sys.path.insert(0, str(HARBOR))
sys.path.insert(0, str(REPO))
sys.path.insert(0, str(Path(__file__).resolve().parent))

from env_wrapper import create_env  # noqa: E402


SB3_CLASS_MAP = {"ppo": PPO, "sac": SAC, "td3": TD3, "ddpg": DDPG, "a2c": A2C}


@hydra.main(version_base=None, config_path="../../../configs/rl", config_name="ppo")
def main(cfg: DictConfig):
    OmegaConf.set_struct(cfg, False)
    algo = str(cfg.get("algo", "ppo"))
    task = cfg.get("task")
    ckpt_path = cfg.get("checkpoint")
    n_episodes = int(cfg.get("n_episodes", 10))

    if task is None:
        print("[error] task=<id> is required.", file=sys.stderr); sys.exit(2)
    if not ckpt_path:
        print("[error] checkpoint=<path> is required.", file=sys.stderr); sys.exit(2)
    ckpt = Path(ckpt_path)
    if not ckpt.is_absolute():
        ckpt = REPO / ckpt
    if not ckpt.exists():
        print(f"[error] checkpoint not found: {ckpt}", file=sys.stderr); sys.exit(2)

    # Eval uses the same n_envs as training by default — keeps obs normalization stats consistent.
    env = create_env(cfg)
    model_cls = SB3_CLASS_MAP[algo]
    model = model_cls.load(str(ckpt), env=env)

    returns: list[float] = []
    lengths: list[int] = []
    start = time.time()

    for ep in range(n_episodes):
        obs = env.reset()
        if isinstance(obs, tuple):  # gymnasium reset returns (obs, info)
            obs = obs[0]
        ep_return = 0.0
        ep_len = 0
        done = False
        while not done:
            action, _ = model.predict(obs, deterministic=True)
            step_out = env.step(action)
            if len(step_out) == 5:                     # gymnasium 5-tuple
                obs, reward, term, trunc, info = step_out
                done = bool(np.any(term)) or bool(np.any(trunc))
            else:                                       # SB3 vec 4-tuple
                obs, reward, done_arr, info = step_out
                done = bool(np.any(done_arr))
            r = float(np.mean(reward)) if hasattr(reward, "__iter__") else float(reward)
            ep_return += r
            ep_len += 1
            if ep_len > 10_000:                         # safety break
                break
        returns.append(ep_return)
        lengths.append(ep_len)
        print(f"[eval] episode {ep+1}/{n_episodes}: return={ep_return:.4f} len={ep_len}", flush=True)

    metrics = {
        "algo": algo,
        "task": str(task),
        "checkpoint": str(ckpt),
        "n_episodes": n_episodes,
        "mean_return": float(np.mean(returns)),
        "std_return":  float(np.std(returns)),
        "min_return":  float(np.min(returns)),
        "max_return":  float(np.max(returns)),
        "mean_length": float(np.mean(lengths)),
        "wall_time_sec": time.time() - start,
    }
    print(f"[eval] mean_return={metrics['mean_return']:.4f} ± {metrics['std_return']:.4f} "
          f"(n={n_episodes})", flush=True)
    (ckpt.parent / "metrics.json").write_text(json.dumps(metrics, indent=2))


if __name__ == "__main__":
    main()
