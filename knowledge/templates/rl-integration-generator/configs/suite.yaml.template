# {{PROJECT_NAME}} — RL suite top-level config.
#
# This file is loaded by harbor/scripts/rl/train.py via hydra; per-algorithm configs
# (ppo.yaml / sac.yaml / td3.yaml or their .parallel variants) compose into it
# under the `algo` key. The values below set RUN-LEVEL defaults; hyperparameters
# live in the per-algorithm files.

defaults:
  - algo: ppo            # override on CLI: --config-name=sac
  - _self_

# ---- Run identity ----
seed: null                # null = draw a fresh random seed at launch; pass seed=N for reproducibility
algo: ppo
task: null                # required at CLI: task=<id>

# ---- Logging ----
log_dir: harbor/outputs/${algo}-${task}-${now:%Y%m%d_%H%M%S}
checkpoint_dir: ${log_dir}
wandb: null               # null = disabled; "<project>" = enabled
wandb_entity: null

# ---- Training budget ----
total_timesteps: 100_000  # FILL IN per-task; see harbor/rl-integration-generator/rl-suite-spec.json training_defaults

# ---- Eval / render defaults ----
eval_episodes: 10
render: true
